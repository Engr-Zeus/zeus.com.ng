---
import '../styles/service-page.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceHero from '../components/service/ServiceHero.astro';
import OfferingGrid from '../components/service/OfferingGrid.astro';
import ProcessSteps from '../components/service/ProcessSteps.astro';
import Faq from '../components/service/Faq.astro';
import EnquirySection from '../components/service/EnquirySection.astro';
import Diagram from '../components/service/visuals/Diagram.astro';
import type { Field } from '../components/service/types';

// OVERVIEW OF TRAINING AREAS: no confirmed course catalogue. No dates, fees, accreditation, certifications,
// employment outcomes, or completion statistics are stated.
const categories = [
  { icon: 'desktop', title: 'Computer fundamentals and digital literacy', text: 'Getting comfortable with computers, files, the internet, and everyday digital tasks.' },
  { icon: 'sliders', title: 'Operating systems and productivity tools', text: 'Using operating systems and common office and productivity software with confidence.' },
  { icon: 'headset', title: 'IT support and troubleshooting', text: 'Diagnosing and resolving common hardware, software, and user problems.' },
  { icon: 'network', title: 'Networking fundamentals', text: 'How networks work, and the basics of setting up and troubleshooting them.' },
  { icon: 'server', title: 'Systems administration fundamentals', text: 'The basics of managing users, systems, and servers.' },
  { icon: 'code', title: 'Web development fundamentals', text: 'An introduction to how websites are built.' },
  { icon: 'briefcase', title: 'Business technology and digital skills', text: 'Using technology to work more effectively in a business setting.' },
  { icon: 'building', title: 'Corporate and customized IT training', text: 'Training shaped around your organization’s tools, teams, and goals.' },
];
const formats = [
  { icon: 'users', title: 'Instructor-led classroom training', text: 'In-person sessions led by an instructor, with the chance to ask questions and practise.' },
  { icon: 'video', title: 'Virtual training', text: 'Live sessions delivered online, so learners can take part from where they are.' },
  { icon: 'building', title: 'Corporate or customized sessions', text: 'Sessions arranged for your team and your requirements.', note: 'Subject to availability.' },
];
const steps = [
  { title: 'Enquiry', text: 'You tell us what you or your team want to learn.' },
  { title: 'Needs assessment', text: 'We discuss current skills, goals, and constraints.' },
  { title: 'Recommended course', text: 'We recommend training areas and a format that fit.' },
  { title: 'Scheduling', text: 'We agree timing and arrangements with you.' },
  { title: 'Delivery', text: 'The training takes place in the agreed format.' },
  { title: 'Feedback', text: 'We ask for your feedback to improve what follows.' },
];
const audiences = [
  { icon: 'user', title: 'Individuals', text: 'People building everyday digital skills or exploring a technology interest.' },
  { icon: 'book', title: 'Students', text: 'Learners who want practical skills alongside their studies.' },
  { icon: 'briefcase', title: 'Professionals', text: 'Working people who want to use technology more effectively or broaden their skills.' },
  { icon: 'building', title: 'Organizations', text: 'Teams and institutions that want their people trained on the tools they use.' },
];
const faqs = [
  { q: 'What courses do you offer?', a: 'This page gives an overview of the training areas we cover. We do not publish a fixed course catalogue, so tell us what you want to learn and we will recommend training that fits.' },
  { q: 'When do courses start, and how much do they cost?', a: 'We do not publish course dates or fees online. Send an enquiry and we will discuss schedules and costs with you.' },
  { q: 'Will I receive a certificate or professional certification?', a: 'We do not advertise accredited certifications. If a certificate of attendance or any other recognition matters to you, ask when you enquire and we will tell you what is available.' },
  { q: 'Can you train my team at our workplace?', a: 'Corporate and customized sessions are available subject to availability. Describe your team and what they need to learn, and we will discuss the options.' },
  { q: 'I am a beginner. Where should I start?', a: 'Computer fundamentals and digital literacy is a good starting point for many people. Tell us your current level and goals, and we will suggest where to begin.' },
  { q: 'Do you offer online training?', a: 'Yes, virtual training is one of our delivery formats. Tell us your preference in the enquiry form.' },
];
const fields: Field[] = [
  { name: 'name', label: 'Full name', required: true, autocomplete: 'name' },
  { name: 'email', label: 'Email address', type: 'email', required: true, autocomplete: 'email' },
  { name: 'phone', label: 'Phone number', type: 'tel', autocomplete: 'tel' },
  { name: 'interest', label: 'Training interest', type: 'select', required: true, options: [...categories.map((c) => c.title), 'Not sure yet'] },
  { name: 'delivery', label: 'Preferred delivery mode', type: 'select', wide: true, options: ['Instructor-led classroom', 'Virtual', 'Corporate or customized session', 'No preference'] },
  { name: 'requirements', label: 'Additional requirements', type: 'textarea', hint: 'Your current level, number of learners, goals, or any timing you have in mind.' },
];
---
<BaseLayout
  title="Technology Training | Zeus System Technologies"
  description="Overview of technology training areas from Zeus System Technologies, from digital literacy to IT support and networking. Enquire about training."
>
  <ServiceHero
    title="Learn Practical Technology Skills. Build Your Future."
    lead="Practical technology training for individuals, students, professionals, and organizations who want to build digital skills they can use."
    primary={{ label: 'Enquire About Training', href: '#enquire' }}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Technology Training' }]}
    schemaName="Technology Training"
    schemaDescription="Technology training in digital skills, IT support, networking, systems administration, and web development fundamentals."
  >
    <figure class="sp-figure">
      <div class="sp-frame"><Diagram name="training" /></div>
      <figcaption>Illustration of classroom and virtual training.</figcaption>
    </figure>
  </ServiceHero>

  <section class="section" aria-labelledby="intro-title">
    <div class="container sp-split">
      <div class="sp-prose">
        <h2 id="intro-title">Technology training from Zeus</h2>
        <p>Alongside our technology services, Zeus System Technologies provides training that helps people use technology well. Whether you are starting with the basics or building specialist skills, we focus on practical learning you can apply.</p>
        <p>We also work with organizations to train their teams on the tools and systems they use every day.</p>
      </div>
      <div class="sp-callout">
        <p><strong>An overview of training areas.</strong> This page describes the areas we cover. It is not a published course catalogue, so dates and fees are not listed. Send an enquiry and we will talk through what is right for you.</p>
      </div>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="cat-title">
    <div class="container">
      <SectionHeading id="cat-title" title="Training areas" intro="Eight areas, from first steps to specialist skills." />
      <OfferingGrid items={categories} cols={2} variant="rows" />
    </div>
  </section>

  <section class="section" aria-labelledby="format-title">
    <div class="container">
      <SectionHeading id="format-title" title="Delivery formats" intro="Learn in the way that suits you." />
      <OfferingGrid items={formats} cols={3} variant="cards" />
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="process-title">
    <div class="container">
      <SectionHeading id="process-title" title="Training process" intro="From your first enquiry to feedback after delivery." />
      <ProcessSteps steps={steps} />
    </div>
  </section>

  <section class="section" aria-labelledby="aud-title">
    <div class="container">
      <SectionHeading id="aud-title" title="Who training is for" intro="People and organizations at every stage." />
      <OfferingGrid items={audiences} cols={4} variant="cards" />
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="faq-title">
    <div class="container">
      <SectionHeading id="faq-title" title="Frequently asked questions" />
      <Faq items={faqs} />
    </div>
  </section>

  <EnquirySection
    title="Enquire About Training"
    text="Tell us what you would like to learn and how you would like to learn it. We will respond to discuss the right training for you."
    formId="training-enquiry"
    subject="Technology Training enquiry"
    submitLabel="Send training enquiry"
    fields={fields}
    useServiceWeb3Forms
    tips={['The area you want to learn', 'Your current level', 'Number of learners, for groups']}
  />
</BaseLayout>

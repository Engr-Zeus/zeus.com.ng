---
import Button from './Button.astro';
import { quoteHref, contactHref } from '../data/site';

interface Props {
  title: string;
  text?: string;
}
const { title, text } = Astro.props;
---
<section class="cta on-dark" aria-labelledby="cta-title">
  <div class="container cta-inner">
    <div>
      <h2 id="cta-title">{title}</h2>
      {text && <p>{text}</p>}
    </div>
    <div class="cta-actions">
      <Button href={quoteHref}>Request a Quote</Button>
      <Button href={contactHref} variant="outline">Contact Us</Button>
    </div>
  </div>
</section>

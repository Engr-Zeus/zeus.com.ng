---
// Line illustrations and diagrams for the service pages. All decorative (aria-hidden); pages add captions.
interface Props { name: string; light?: boolean }
const { name, light = false } = Astro.props;
const vb: Record<string, string> = {
  'managed-map': '0 0 400 300', workflow: '0 0 400 200', data: '0 0 400 230', integration: '0 0 400 260',
  rack: '0 0 300 380', topology: '0 0 400 260', cloud: '0 0 400 260', plan: '0 0 400 300', smarthome: '0 0 400 280',
  camera: '0 0 320 170', foundation: '0 0 400 280', training: '0 0 400 300', bench: '0 0 400 280',
  'p-server': '0 0 160 110', 'p-desktop': '0 0 160 110', 'p-laptop': '0 0 160 110', 'p-monitor': '0 0 160 110', 'p-peripherals': '0 0 160 110', 'p-accessories': '0 0 160 110',
};
---
<svg class:list={['sp-art', light && 'sp-art--light']} viewBox={vb[name]} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'managed-map' && (
    <>
      <path class="dim" d="M200 16L336 58V150C336 218 274 266 200 288C126 266 64 218 64 150V58Z" />
